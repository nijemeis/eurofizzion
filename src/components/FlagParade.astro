---
import Ring from './Ring.astro';
import { countryList } from '../lib/content';

// Every country with a page, alphabetically. The list is doubled so the marquee loops seamlessly;
// the second copy is hidden from screen readers and the tab order.
---

<nav class="parade" aria-label="Countries">
  <div class="parade-mask">
    <div class="parade-track">
      {
        [0, 1].map((copy) =>
          countryList.map((c) => (
            <a class="parade-item" href={`/country/${c.slug}/`} aria-hidden={copy ? 'true' : undefined} tabindex={copy ? -1 : undefined}>
              <Ring code={c.code} />
              <span>{c.name}</span>
            </a>
          )),
        )
      }
    </div>
  </div>
</nav>
