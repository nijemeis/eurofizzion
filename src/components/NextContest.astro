---
import Sparkles from './Sparkles.astro';
import NewsBar from './NewsBar.astro';
import { countries, countryHref } from '../lib/content';
import type { Upcoming } from '../lib/types';

interface Props {
  up: Upcoming;
}
const { up } = Astro.props;
const chips = [
  ...up.debut.map((c) => ({ c, label: 'Debut', kind: 'debut' })),
  ...up.returning.map((c) => ({ c, label: 'Returning', kind: 'returning' })),
  ...up.leaving.map((c) => ({ c, label: 'Not returning', kind: 'leaving' })),
  ...(up.undecided || []).map((c) => ({ c, label: 'Undecided', kind: 'undecided' })),
];
// Every country on the list, alphabetically, with its act once announced.
const field = (up.participants || [])
  .map((c) => ({ c, name: countries[c] || c, act: up.acts?.[c], href: countryHref(c) }))
  .sort((a, b) => a.name.localeCompare(b.name));
---

<section class="next" id="next">
  <Sparkles count={30} seed={2027} />
  <div class="next-inner">
    <div class="next-kicker">{up.kicker}</div>
    <h2 class="next-title">{up.city} {up.year}</h2>
    <p class="next-blurb">{up.blurb}</p>

    <div class="shows">
      {
        up.shows.map((s, i) => (
          <div class={`show show-${i % 3}`}>
            <div class="show-name">{s.name}</div>
            <div class="show-date">{s.date}</div>
            <div class="show-where">
              {up.venue} · {up.year}
            </div>
          </div>
        ))
      }
    </div>

    <div class="part">
      <div class="part-head">
        <b>{up.intending}</b>
        <span>broadcasters have provisionally confirmed for {up.year}</span>
        {up.participantsAsOf && <small class="part-asof">as of {up.participantsAsOf}</small>}
      </div>
      {
        chips.length > 0 && (
          <div class="part-chips">
            {chips.map((o) => {
              // Linked to the country's page when it has one (a debutant doesn't yet).
              const href = countryHref(o.c);
              const Tag = href ? 'a' : 'span';
              return (
                <Tag class={`pchip pchip-${o.kind}`} href={href ?? undefined}>
                  <i class="flag" style={`background-image:url(/flags/${o.c}.svg)`} />
                  {countries[o.c] || o.c} · {o.label}
                </Tag>
              );
            })}
          </div>
        )
      }
      {
        field.length > 0 && (
          <ul class="part-field">
            {field.map((p) => {
              const Tag = p.href ? 'a' : 'div';
              return (
                <li>
                  <Tag class="pf" href={p.href ?? undefined}>
                    <i class="flag" style={`background-image:url(/flags/${p.c}.svg)`} />
                    <span>
                      <b>{p.name}</b>
                      {p.act?.artist && <small>{p.act.artist}{p.act.song ? ` · “${p.act.song}”` : ''}</small>}
                    </span>
                  </Tag>
                </li>
              );
            })}
          </ul>
        )
      }
      <div class="part-foot">Entries appear here as each country picks its act.</div>
    </div>

    <NewsBar />
  </div>
</section>
