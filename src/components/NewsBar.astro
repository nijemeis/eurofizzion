---
// News bar: the editor's picks first, then the latest feed items. Hidden while there are none.
import picksJson from '../../content/news-picks.json';
import feedJson from '../../content/news.json';
import { mergeNews, newsDate, type NewsItem } from '../lib/news';

const items = mergeNews(picksJson.items as NewsItem[], feedJson.items as NewsItem[]);
---

{
  items.length > 0 && (
    <div class="news">
      <div class="news-head">
        <div class="next-kicker" style="font-size:24px">The latest Eurovision news</div>
      </div>
      <div class="news-row">
        {items.map((n) => (
          <a class="news-card" href={n.url} target="_blank" rel="noopener">
            <div class="news-img">{n.image && <img src={n.image} alt="" loading="lazy" decoding="async" referrerpolicy="no-referrer" />}</div>
            <div class="news-body">
              {n.date && <time datetime={n.date}>{newsDate(n.date)}</time>}
              <b>{n.title}</b>
              {n.excerpt && <p>{n.excerpt}</p>}
              <span class="news-more">Read on {n.source} ↗</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  )
}
