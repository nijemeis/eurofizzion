---
import Ring from './Ring.astro';
import Icon from './Icon.astro';
import type { EmptyView, FullView } from '../lib/derive';

interface Props {
  view: FullView | EmptyView;
}
const { view } = Astro.props;
const full = view.kind === 'full' ? view : null;
---

<section class="wrap entries-section" id="entries">
  <div class="section-head">
    <div>
      <div class="kicker">The entries</div>
      <h2 class="h2">{view.yearTitle}</h2>
      {view.sub && <p class="lede">{view.sub}</p>}
    </div>
    {
      full?.counts && (
        <div class="filters" role="group" aria-label="Filter entries">
          <button type="button" class="pill" data-filter="all" aria-pressed="true">All {full.counts.all}</button>
          <button type="button" class="pill" data-filter="final" aria-pressed="false">Grand final {full.counts.final}</button>
          <button type="button" class="pill" data-filter="semi" aria-pressed="false">Out in the semis {full.counts.semi}</button>
        </div>
      )
    }
  </div>

  {
    full ? (
      <div class="grid">
        {full.entries.map((e) => (
          <button type="button" class="card" data-open={e.c} data-stage={e.place ? 'final' : 'semi'} aria-label={`${e.country}: ${e.artist}, “${e.song}” — play`}>
            <div class="thumb">
              <div class="thumb-rim" style={`background-image:url(/flags/${e.c}.svg)`} />
              {e.thumb && <div class="thumb-img" style={`background-image:url(${e.thumb})`} />}
              <div class="thumb-shade" />
              <div class="thumb-ro">{e.roLabel}</div>
              <div class={`badge badge-${e.badge}`}>{e.placeLabel}</div>
              <div class="thumb-play">
                <div class="play">
                  <Icon name="play" size={18} />
                </div>
              </div>
              {e.thumb && <div class="thumb-fmt">{e.formats}</div>}
              <div class="thumb-country">
                <Ring code={e.c} />
                <span>{e.country}</span>
              </div>
            </div>
            <div class="card-body">
              <div class="card-artist">{e.artist}</div>
              <div class="card-song">“{e.song}”</div>
              {e.subLabel && <div class="card-meta">{e.subLabel}</div>}
            </div>
          </button>
        ))}
      </div>
    ) : (
      view.kind === 'empty' && (
        <div class="empty">
          <div class="empty-title">{view.emptyTitle}</div>
          <p>{view.emptyText}</p>
        </div>
      )
    )
  }
</section>
