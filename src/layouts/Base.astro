---
import '@fontsource/unbounded/700.css';
import '@fontsource/unbounded/800.css';
import '@fontsource/dm-sans/400.css';
import '@fontsource/dm-sans/500.css';
import '@fontsource/dm-sans/700.css';
import '@fontsource/kaushan-script/400.css';
import '@fontsource/pacifico/latin-400.css';
import '../styles/global.css';
import Consent from '../components/Consent.astro';

interface Props {
  title: string;
  description: string;
  canonical: string;
}
const { title, description, canonical } = Astro.props;
const canonicalUrl = new URL(canonical, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#090d35" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Eurofizzion" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <link rel="preconnect" href="https://i.ytimg.com" />
    <!--
      Google Analytics with consent (Google Consent Mode v2, "basic" mode): gtag.js is only loaded after the
      visitor clicks Accept, so nothing is sent to Google before that. The choice lives in localStorage.
      is:inline keeps Astro from bundling it. Public pages only; the CMS has its own layout.
    -->
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag('consent', 'default', { ad_storage: 'denied', ad_user_data: 'denied', ad_personalization: 'denied', analytics_storage: 'denied' });
      window.efAnalytics = function () {
        gtag('consent', 'update', { analytics_storage: 'granted' });
        if (window.efGtagLoaded) return;
        window.efGtagLoaded = true;
        var s = document.createElement('script');
        s.async = true;
        s.src = 'https://www.googletagmanager.com/gtag/js?id=G-B4TRVQCWR4';
        document.head.appendChild(s);
        gtag('js', new Date());
        gtag('config', 'G-B4TRVQCWR4');
      };
      try {
        if (localStorage.getItem('ef-consent') === 'granted') window.efAnalytics();
      } catch (e) {}
    </script>
  </head>
  <body>
    <slot />
    <Consent />
  </body>
</html>
