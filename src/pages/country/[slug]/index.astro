---
// Every entry a country has sent, newest first.
import SiteChrome from '../../../components/SiteChrome.astro';
import Ring from '../../../components/Ring.astro';
import EntryCard from '../../../components/EntryCard.astro';
import VideoModal from '../../../components/VideoModal.astro';
import { archive, contests, countries, countryList } from '../../../lib/content';
import { countryView } from '../../../lib/derive';

export function getStaticPaths() {
  return countryList.map((c) => ({ params: { slug: c.slug }, props: { code: c.code } }));
}
const { code } = Astro.props;
const v = countryView(code, contests, archive, countries);
// Longest word sets the heading size, so long names shrink instead of breaking mid-word.
const chars = Math.max(6, ...v.name.split(/\s+/).map((w) => w.length));
const span = v.entries.length ? `${v.entries[v.entries.length - 1].year}–${v.entries[0].year}` : '';
const filters = [
  ['all', 'All', v.counts.all],
  ['final', 'Grand final', v.counts.final],
  ['top10', 'Top 10', v.counts.top10],
  ['win', 'Wins', v.counts.win],
] as const;
---

<SiteChrome
  title={`${v.name} at Eurovision — every entry ${span} | Eurofizzion`}
  description={`All ${v.counts.all} Eurovision entries from ${v.name} (${span}), with ${v.counts.win} win${v.counts.win === 1 ? '' : 's'}: watch the performances and see every placing.`}
  canonical={`/country/${v.slug}/`}
>
  <section class="wrap country-hero" aria-label={v.name}>
    <div class="country-card">
      <div class="spot-main">
        <Ring code={code} label={v.name} class="spot-flag" />
        <div class="country-text">
          <div class="kicker">Every entry from</div>
          <h1 class="country-name" style={`--chars:${chars}`}>{v.name}</h1>
          <a class="country-back" href="/country/">← All countries</a>
        </div>
      </div>
      <div class="spot-side">
        <div class="stats">
          {
            v.stats.map((s) => (
              <div class="stat">
                <b class={`tone-${s.tone}`}>{s.v}</b>
                <span>{s.l}</span>
              </div>
            ))
          }
        </div>
        {v.coverage && <p class="country-note">{v.coverage}</p>}
      </div>
    </div>
  </section>

  <section class="wrap entries-section" id="entries" style="padding-top:64px">
    <div class="section-head">
      <div>
        <div class="kicker">From the latest to the first</div>
        <h2 class="h2">{v.name} at Eurovision</h2>
        <p class="lede">{v.counts.all} entries · {span}</p>
      </div>
      <div class="filters" role="group" aria-label="Filter entries">
        {
          filters
            .filter(([, , n], i) => i === 0 || n > 0)
            .map(([key, label, n]) => (
              <button type="button" class="pill" data-filter={key} aria-pressed={key === 'all' ? 'true' : 'false'}>
                {label} {n}
              </button>
            ))
        }
      </div>
    </div>
    <div class="grid">
      {v.entries.map((e) => <EntryCard e={e} openKey={e.key} tags={e.tags} label={e.hosted ? `${e.yearTitle} · Host` : e.yearTitle} />)}
    </div>
  </section>

  <VideoModal
    slot="after"
    entries={v.entries.map((e) => ({ ...e, link: `/${e.year}/`, linkLabel: `Open ${e.yearTitle} →` }))}
  />
</SiteChrome>
